{
  "name": "retrospective",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "retrospective.rocher.lc", "custom_domain": true }],
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "retrospective-db",
      "database_id": "a909c5f0-807c-464a-89a3-2cab7023f1fe"
    }
  ]
}
